def get_call_service(request: Request) -> ACSCallService:
    """Get call service from app state with error handling"""
    if not hasattr(request.app.state, 'call_service'):
        logger.error("❌ Call service not initialized in app state")
        raise HTTPException(
            status_code=500,
            detail="Call service not available"
        )
    return request.app.state.call_service

def get_conversation_manager(request: Request) -> ConversationManager:
    """Get conversation manager from app state with error handling"""
    if not hasattr(request.app.state, 'conversation_manager'):
        logger.error("❌ Conversation manager not initialized in app state")
        raise HTTPException(
            status_code=500,
            detail="Conversation Manager service not available"
        )
    return request.app.state.conversation_manager

def get_redis_manager(request: Request) -> Optional[AzureRedisManager]:
    """Get Redis manager from app state with error handling"""
    if not hasattr(request.app.state, 'redis'):
        logger.error("❌ Redis manager not initialized in app state")
        raise HTTPException(
            status_code=500,
            detail="Redis Manager service not available"
        )
    return request.app.state.redis

def get_event_manager(call_id, request: Request) -> ACSEventManager:
    """Get event manager from app state (initialized with shared services)"""
    return ACSEventManager(
            call_id=call_id,
            recording_config=recording_config,
            session_manager=get_session_manager(request),
            call_service=get_call_service(request),
            conversation_manager=get_conversation_manager(request),
            redis_mgr=get_redis_manager(request),
            app_state=request.app.state,
    )
