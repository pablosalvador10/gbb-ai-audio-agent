# --------------------------------------------------------------------------- #
#  1. Call initiation  (POST /call)
# --------------------------------------------------------------------------- #
class CallRequest(BaseModel):
    target_number: str


@router.post("/api/call")
async def initiate_call(call: CallRequest, request: Request):

    try:
        
        acs = request.app.state.call_service
        redis_mgr = request.app.state.redis
        # cm = request.app.state.conversation_manager
        cm = await ConversationManager.from_redis(
            session_id=call.target_number, 
            redis_mgr=redis_mgr
        )
        acs_session_manager = request.app.state.session_manager

        if not acs or not redis_mgr:
            raise HTTPException(503, "ACS Caller or Redis Manager not initialised")

        result = await acs.initiate_call(call.target_number)
        if result.get("status") != "created":
            return JSONResponse({"status": "failed"}, status_code=400)

        call_id = result["call_id"]
        logger.info("Call initiated – ID=%s", call_id)

        # Create or retrieve session for this call
        loaded_cm = await cm.from_redis(call_id, redis_mgr)

        session_result = await loaded_cm.persist_to_redis(
            ttl_seconds=3600  # Set TTL for 1 hour
        )


        # session_result = await acs_session_manager.create_session(
        #     call_connection_id=call_id,
        # )

        if not session_result:
            logger.error(f"Failed to create session for call ID: {call_id}")
            raise HTTPException(500, "Failed to create session for call")

    except (HttpResponseError, RuntimeError) as exc:
        logger.error("ACS error: %s", exc, exc_info=True)
        raise HTTPException(500, str(exc)) from exc


# --------------------------------------------------------------------------- #
#  2. Callback events  (POST /call/callbacks)  
# --------------------------------------------------------------------------- #
@router.post(ACS_CALLBACK_PATH)
async def callbacks(
    request: Request,
) -> JSONResponse:
    """
    Enhanced ACS callback handler with comprehensive event management.
    
    Features:
    - Automatic recording start/stop based on call events
    - Session tracking and state management
    - Comprehensive error handling and logging
    - Integration with existing conversation management
    """
    correlation_id = request.headers.get("x-correlation-id", "unknown")
    
    try:
        # Parse the incoming callback data
        callback_data = await request.json()
        
        # Extract event information for routing
        events = callback_data if isinstance(callback_data, list) else [callback_data]
        
        # Process each event with proper error handling and logging
        results = []
        

        for event in events:
            try:
                # Extract event type and routing information
                event_type = event.get("type", "unknown")
                call_connection_id = event.get("call_connection_id", "unknown")
                event_manager = get_event_manager(call_connection_id, request)        
                # Add correlation ID for distributed tracing
                event["correlation_id"] = correlation_id
                
                logger.info(
                    f"🔄 Processing ACS event: {event_type}",
                    extra={
                        "event_type": event_type,
                        "call_connection_id": call_connection_id,
                        "correlation_id": correlation_id
                    }
                )
                
                # Route to appropriate event handler using enhanced event manager
                result = await event_manager.process_callback_events(call_connection_id=call_connection_id, events=[event])
                
                # Enhanced result processing with Azure monitoring patterns
                if result.get("success", False):
                    logger.info(
                        f"✅ Successfully processed {event_type}",
                        extra={
                            "event_type": event_type,
                            "call_connection_id": call_connection_id,
                            "correlation_id": correlation_id,
                            "result": result
                        }
                    )
                else:
                    logger.warning(
                        f"⚠️ Event processing completed with warnings: {event_type}",
                        extra={
                            "event_type": event_type,
                            "call_connection_id": call_connection_id,
                            "correlation_id": correlation_id,
                            "error": result.get("error", "Unknown issue")
                        }
                    )
                
                results.append({
                    "event_type": event_type,
                    "call_connection_id": call_connection_id,
                    "success": result.get("success", False),
                    "result": result
                })
                
            except Exception as event_error:
                # Handle individual event processing errors gracefully
                logger.error(
                    f"❌ Error processing individual event: {event.get('type', 'unknown')}",
                    extra={
                        "event_type": event.get("type", "unknown"),
                        "call_connection_id": event.get("call_connection_id", "unknown"),
                        "correlation_id": correlation_id,
                        "error": str(event_error)
                    },
                    exc_info=True
                )
                
                results.append({
                    "event_type": event.get("type", "unknown"),
                    "call_connection_id": event.get("call_connection_id", "unknown"),
                    "success": False,
                    "error": str(event_error)
                })
        
        # Aggregate results and determine overall success
        total_events = len(results)
        successful_events = sum(1 for r in results if r.get("success", False))
        success_rate = successful_events / total_events if total_events > 0 else 0
        
        # Log aggregate results for monitoring
        logger.info(
            f"📊 ACS callback batch processed: {successful_events}/{total_events} successful",
            extra={
                "total_events": total_events,
                "successful_events": successful_events,
                "success_rate": success_rate,
                "correlation_id": correlation_id
            }
        )
        
        # Return structured response following Azure API patterns
        response_data = {
            "success": success_rate >= 0.8,  # Consider 80%+ success rate as overall success
            "total_events": total_events,
            "successful_events": successful_events,
            "success_rate": success_rate,
            "results": results,
            "correlation_id": correlation_id
        }
        
        return JSONResponse(
            status_code=200,
            content=response_data
        )

    except Exception as e:
        # Handle top-level processing errors with comprehensive logging
        logger.error(
            f"❌ Critical error in ACS callback processing",
            extra={
                "correlation_id": correlation_id,
                "error": str(e),
                "request_path": str(request.url)
            },
            exc_info=True
        )
        
        # Return error response following Azure error handling patterns
        return JSONResponse(
            status_code=500,
            content={
                "success": False,
                "error": "Internal server error processing ACS callbacks",
                "correlation_id": correlation_id,
            }
        )
# --------------------------------------------------------------------------- #
#  3. Media-streaming WebSocket  (WS /call/stream)
# --------------------------------------------------------------------------- #
call_user_raw_ids: Dict[str, str] = {}

@router.websocket(ACS_WEBSOCKET_PATH)
async def acs_media_ws(ws: WebSocket):
    speech = ws.app.state.stt_client
    acs = ws.app.state.call_service
    if not speech or not acs:
        await ws.close(code=1011)
        return

    await ws.accept()
    cid = ws.headers.get("x-ms-call-connection-id", "UnknownCall")
    logger.info("▶ media WS connected – %s", cid)

    # ----------------------------------------------------------------------- #
    #  Local objects
    # ----------------------------------------------------------------------- #
    queue: asyncio.Queue[str] = asyncio.Queue()
    push_stream = PushAudioInputStream(
        stream_format=AudioStreamFormat(samples_per_second=16000, bits_per_sample=16, channels=1)
    )
    recogniser = speech.create_realtime_recognizer(
        push_stream=push_stream,
        loop=asyncio.get_event_loop(),
        message_queue=queue,
        language="en-US",
        vad_silence_timeout_ms=500,
    )
    recogniser.start_continuous_recognition_async()

    cm = await ws.app.state.conversation_manager.load_from_redis(cid)
    ws.state.lt = LatencyTool(cm)

    clients = ws.app.state.clients
    greeted: set[str] = ws.app.state.greeted_call_ids
    if cid not in greeted:
        greet = (
            "Hello from XMYX Healthcare Company! Before I can assist you, "
            "let’s verify your identity. How may I address you?"
        )
        await broadcast_message(clients, greet, "Assistant")
        await send_response_to_acs(ws, greet)
        await cm.append_to_history("assistant", greet)
        greeted.add(cid)

    user_raw_id = call_user_raw_ids.get(cid)

    try:
        # --- inside acs_media_ws ---------------------------------------------------
        while True:
            spoken: str | None = None
            try:
                while True:
                    item = queue.get_nowait()
                    spoken = f"{spoken} {item}".strip() if spoken else item
                    queue.task_done()
            except asyncio.QueueEmpty:
                pass

            if spoken:
                ws.app.state.tts_client.stop_speaking()
                for t in list(getattr(ws.app.state, "tts_tasks", [])):
                    t.cancel()

                await broadcast_message(clients, spoken, "User")

                if check_for_stopwords(spoken):
                    await broadcast_message(clients, "Goodbye!", "Assistant")
                    await send_response_to_acs(ws, "Goodbye!", blocking=True)
                    await asyncio.sleep(1)
                    await acs.disconnect_call(cid)
                    break

                await route_turn(cm, spoken, ws, is_acs=True)
            try:
                raw = await asyncio.wait_for(ws.receive_text(), timeout=5.0)
                data = json.loads(raw)
            except asyncio.TimeoutError:
                if ws.client_state != WebSocketState.CONNECTED:
                    break
                continue
            except (WebSocketDisconnect, json.JSONDecodeError):
                break

            kind = data.get("kind")
            if kind == "AudioData":
                # dynamically learn / confirm the caller’s participantRawID
                if not user_raw_id and cid in call_user_raw_ids:
                    user_raw_id = call_user_raw_ids[cid]

                if user_raw_id and data["audioData"]["participantRawID"] != user_raw_id:
                    continue        # discard bot’s own audio

                try:
                    push_stream.write(b64decode(data["audioData"]["data"]))
                except Exception:
                    # keep going even if decode glitches
                    continue

            elif kind == "CallConnected":
                pid = data["callConnected"]["participant"]["rawID"]
                call_user_raw_ids[cid] = pid
                user_raw_id = pid

    finally:
        try:
            recogniser.stop_continuous_recognition_async()
        except Exception:  # pylint: disable=broad-except
            pass
        push_stream.close()
        await ws.close()
        call_user_raw_ids.pop(cid, None)
        await cm.persist_to_redis()
        logger.info("◀ media WS closed – %s", cid)



