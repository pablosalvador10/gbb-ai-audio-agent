{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        { // Added React Debug Configuration
            "name": "[RT Agent] React App: Browser Debug",
            "type": "msedge", // or "chrome"
            "request": "launch",
            "url": "http://localhost:5173", // Ensure this matches your Vite dev server port
            "webRoot": "${workspaceFolder}/rtagents/RTAgent/frontend",
            "sourceMaps": true,
            "sourceMapPathOverrides": {
                "webpack:///src/*": "${webRoot}/src/*",
                "webpack:///*": "${webRoot}/*"
            }
        },

        {
            "name": "[RT Agent] Python Debugger: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "rtagents.RTAgent.backend.main:app",
                "--reload",
                "--port",
                "8010"
            ],
            "jinja": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "envFile": "${workspaceFolder}/.env"
        },

    ],
    "compounds": [
        {
            "name": "[RT Agent] Full Stack: Backend + Frontend",
            "configurations": ["[RT Agent] Python Debugger: FastAPI", "[RT Agent] React App: Browser Debug"]
        }
    ]
}